# Ignore everything by default
**

# --- Root ---
!.gitignore
!.gitattributes
!.editorconfig
!.pre-commit-config.yaml
!.release-please-manifest.json
!release-please-config.json
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!LICENSE
!README.md
!SECURITY.md
!SUPPORT.md

# --- .config ---
!.config/
!.config/.markdownlint.json
!.config/.yamllint.yaml

# --- .github ---
!.github/
!.github/CODEOWNERS
!.github/FUNDING.yml
!.github/renovate.json5
!.github/pull_request_template.md
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/bug_report.yml
!.github/ISSUE_TEMPLATE/feature_request.yml
!.github/ISSUE_TEMPLATE/config.yml
!.github/workflows/
!.github/workflows/pr-verify.yaml
!.github/workflows/iam.yml
!.github/workflows/packer.yaml
!.github/workflows/release-please.yaml
!.github/workflows/security.yaml
!.github/workflows/repo-hygiene.yaml

# --- .vscode ---
!.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json

# --- docs ---
!docs/
!docs/README.md
!docs/explanation/
!docs/explanation/stig-cis-hardening-strategy.md
!docs/reference/
!docs/reference/aws-iam/
!docs/reference/aws-iam/README.md
!docs/reference/aws-iam/roles/
!docs/reference/aws-iam/roles/github_nwarila-platform_secure-rhel8-ami.trust.json
!docs/reference/aws-iam/roles/github_nwarila-platform_secure-rhel8-ami-admin.trust.json
!docs/reference/aws-iam/policies/
!docs/reference/aws-iam/policies/secure-rhel8-ami_packer-build.json
!docs/reference/aws-iam/policies/secure-rhel8-ami_packer-publish.json
!docs/reference/aws-iam/policies/secure-rhel8-ami_boundary.json
!docs/reference/aws-iam/policies/secure-rhel8-ami_iam-manage.json
!docs/reference/aws-iam/policies/secure-rhel8-ami_iam-admin.json
!docs/runbooks/
!docs/runbooks/manual-packer-build.md

# --- scripts ---
!scripts/
!scripts/bootstrap-iam.sh
!scripts/check-iam-literals.sh

# --- packer ---
# The shared Packer template, one line per file: a new template file is a deliberate
# addition. The manifests/ directory exists for Packer's output (the manifest
# post-processor fails without it) and stays empty in the tree.
!packer/
!packer/builds.pkr.hcl
!packer/data.pkr.hcl
!packer/locals.pkr.hcl
!packer/packer.pkr.hcl
!packer/source.pkr.hcl
!packer/variables.pkr.hcl
!packer/manifests/
!packer/manifests/.gitkeep

# --- images ---
# One folder per image; the profile vars files are the build matrix's second dimension.
# Build evidence is written under images/<image>/evidence/ at run time and stays ignored.
!images/
!images/rhel-8/
!images/rhel-8/rhel-8.pkrvars.hcl
!images/rhel-8/playbook.yml
!images/rhel-8/user-data.pkrtpl.hcl
!images/rhel-8/profiles/
!images/rhel-8/profiles/stig.yml
