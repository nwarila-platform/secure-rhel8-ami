{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoveryDescribes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstances",
        "ec2:DescribeRegions",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TempKeyPairLifecycle",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateKeyPair",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*"
    },
    {
      "Sid": "TagKeyPairOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateKeyPair"
        }
      }
    },
    {
      "Sid": "TempSecGroupCreateInVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*"
    },
    {
      "Sid": "TempSecGroupVpcLeg",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<region>:<account-id>:vpc/<vpc-id>"
    },
    {
      "Sid": "TagSecGroupOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSecurityGroup"
        }
      }
    },
    {
      "Sid": "TempSecGroupLifecycleOurs",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        },
        "ArnEquals": {
          "ec2:Vpc": "arn:aws:ec2:<region>:<account-id>:vpc/<vpc-id>"
        }
      }
    },
    {
      "Sid": "RunInstanceLegImdsV2",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:<account-id>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": "t3.medium",
          "ec2:MetadataHttpTokens": "required"
        },
        "NumericEquals": {
          "ec2:MetadataHttpPutResponseHopLimit": 1
        }
      }
    },
    {
      "Sid": "TagOnLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:<region>:<account-id>:instance/*",
        "arn:aws:ec2:<region>:<account-id>:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "RunUntaggableLegs",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*",
        "arn:aws:ec2:<region>:<account-id>:subnet/<subnet-id>"
      ]
    },
    {
      "Sid": "RunEniLegSubnetPinned",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:<account-id>:network-interface/*",
      "Condition": {
        "ArnEquals": {
          "ec2:Subnet": "arn:aws:ec2:<region>:<account-id>:subnet/<subnet-id>"
        }
      }
    },
    {
      "Sid": "RunSecGroupLegOurs",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        },
        "ArnEquals": {
          "ec2:Vpc": "arn:aws:ec2:<region>:<account-id>:vpc/<vpc-id>"
        }
      }
    },
    {
      "Sid": "RunVolumeLegEncrypted",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>:<account-id>:volume/*",
      "Condition": {
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": 30
        }
      }
    },
    {
      "Sid": "RunImageLegUpstream",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>::image/ami-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<source-ami-owner>"
        }
      }
    },
    {
      "Sid": "RunImageLegOurs",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:<region>::image/ami-*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    },
    {
      "Sid": "InstanceLifecycleOnlyOurs",
      "Effect": "Allow",
      "Action": [
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:<region>:<account-id>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    },
    {
      "Sid": "ReadOurConsoleOutput",
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:<region>:<account-id>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    },
    {
      "Sid": "EnaFlagOnOurInstances",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceAttribute",
      "Resource": "arn:aws:ec2:<region>:<account-id>:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>",
          "ec2:Attribute": "EnaSupport"
        }
      }
    },
    {
      "Sid": "SurrogateSnapCreateLeg",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:<region>::snapshot/*"
    },
    {
      "Sid": "TagSnapshotOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshot"
        }
      }
    },
    {
      "Sid": "SurrogateSnapVolumeLeg",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": "arn:aws:ec2:<region>:<account-id>:volume/*",
      "Condition": {
        "Bool": {
          "ec2:Encrypted": "true"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": 30
        }
      }
    },
    {
      "Sid": "SnapshotDeleteOnlyOurs",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    },
    {
      "Sid": "RegisterImageSnapshotLeg",
      "Effect": "Allow",
      "Action": "ec2:RegisterImage",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        },
        "Bool": {
          "ec2:Encrypted": "true"
        }
      }
    },
    {
      "Sid": "RegisterImageImageLeg",
      "Effect": "Allow",
      "Action": "ec2:RegisterImage",
      "Resource": "arn:aws:ec2:<region>::image/*"
    },
    {
      "Sid": "ImageAttrsAllowlisted",
      "Effect": "Allow",
      "Action": "ec2:ModifyImageAttribute",
      "Resource": "arn:aws:ec2:<region>::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:Attribute": [
            "Description",
            "ImdsSupport"
          ]
        }
      }
    },
    {
      "Sid": "TagOurRegisteredImages",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>::image/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "DeregisterOnlyOurImages",
      "Effect": "Allow",
      "Action": "ec2:DeregisterImage",
      "Resource": "arn:aws:ec2:<region>::image/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    },
    {
      "Sid": "RetagOurTaggedSnapshots",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/RepositoryId": "<repository-id>"
        }
      }
    }
  ]
}
