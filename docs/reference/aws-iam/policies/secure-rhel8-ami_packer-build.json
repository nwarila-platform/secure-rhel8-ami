{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoveryDescribes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeRegions",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TemporaryKeyPairCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateKeyPair",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*"
    },
    {
      "Sid": "TagKeyPairOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateKeyPair"
        }
      }
    },
    {
      "Sid": "TemporarySecurityGroupCreateInPinnedVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*"
    },
    {
      "Sid": "TemporarySecurityGroupVpcLeg",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:<region>:<account-id>:vpc/<vpc-id>"
    },
    {
      "Sid": "TagSecurityGroupOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>:<account-id>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSecurityGroup"
        }
      }
    }
  ]
}
