{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoveryDescribes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeImages",
        "ec2:DescribeRegions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TemporaryKeyPairCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateKeyPair",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*"
    },
    {
      "Sid": "TagKeyPairOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<region>:<account-id>:key-pair/packer_*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateKeyPair"
        }
      }
    }
  ]
}
