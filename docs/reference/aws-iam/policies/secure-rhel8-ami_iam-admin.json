{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAllRepoPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:TagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::<account-id>:policy/secure-rhel8-ami_packer-build",
        "arn:aws:iam::<account-id>:policy/secure-rhel8-ami_boundary",
        "arn:aws:iam::<account-id>:policy/secure-rhel8-ami_iam-manage",
        "arn:aws:iam::<account-id>:policy/secure-rhel8-ami_iam-admin"
      ]
    },
    {
      "Sid": "ManageBuildRole",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::<account-id>:role/github_nwarila-platform_secure-rhel8-ami"
    },
    {
      "Sid": "CreateBuildRoleOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::<account-id>:role/github_nwarila-platform_secure-rhel8-ami",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::<account-id>:policy/secure-rhel8-ami_boundary"
        }
      }
    },
    {
      "Sid": "ValidateDocumentsBeforeApply",
      "Effect": "Allow",
      "Action": "access-analyzer:ValidatePolicy",
      "Resource": "*"
    },
    {
      "Sid": "ResolveSubstitutionValues",
      "Effect": "Allow",
      "Action": "ec2:DescribeVpcs",
      "Resource": "*"
    },
    {
      "Sid": "DenySelfMutation",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "arn:aws:iam::<account-id>:role/github_nwarila-platform_secure-rhel8-ami-admin"
    }
  ]
}
