{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsForSecureRhel8AmiPackerBuild",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:repository_id": "<repository-id>"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:nwarila-platform@<owner-id>/secure-rhel8-ami@<repository-id>:*",
            "repo:nwarila-platform/secure-rhel8-ami:*"
          ],
          "token.actions.githubusercontent.com:job_workflow_ref": [
            "nwarila-platform/secure-rhel8-ami/.github/workflows/packer.yaml@*",
            "nwarila-platform/secure-rhel8-ami/.github/workflows/iam.yml@*"
          ]
        }
      }
    }
  ]
}
