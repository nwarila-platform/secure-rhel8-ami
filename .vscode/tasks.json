{
  // ======================================================================== //
  //  VS Code Tasks — Quick-access repository operations                     //
  //                                                                          //
  //  Run via: Terminal > Run Task... (Ctrl+Shift+P > Tasks: Run Task)        //
  // ======================================================================== //
  "version": "2.0.0",
  "tasks": [
    // ---- Packer Inventory ------------------------------------------------ //
    {
      "label": "Packer: Format",
      "type": "shell",
      "command": "packer fmt -recursive -diff .",
      "options": { "cwd": "${workspaceFolder}/packer" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Packer: Format Check",
      "type": "shell",
      "command": "packer fmt -check -recursive .",
      "options": { "cwd": "${workspaceFolder}/packer" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    // ---- Pre-Commit ----------------------------------------------------- //
    {
      "label": "Pre-Commit: Run All",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
